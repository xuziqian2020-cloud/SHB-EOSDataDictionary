<Window x:Class="SHB.EosDataDictionary.ConnectionManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接与数据管理"
        Width="1020"
        Height="680"
        MinWidth="920"
        MinHeight="600"
        Icon="Assets/EosDataDictionary.ico"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="10" /><RowDefinition Height="42" /></Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="48" /></Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                        <TextBlock Text="连接配置" Style="{StaticResource SectionTitleTextStyle}" />
                    </Border>
                    <ListBox x:Name="ProfileList" Grid.Row="1" Margin="7,6" SelectionChanged="ProfileList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="18" /><RowDefinition Height="18" /></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1" Text="{Binding Server}" Foreground="{DynamicResource App.TextMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="2" Text="{Binding Database}" Foreground="{DynamicResource App.AccentBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="2" Margin="8,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="新增" Click="NewButton_Click" />
                        <Button Grid.Column="2" Content="删除" Click="DeleteButton_Click" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                        <Grid>
                            <TextBlock Text="SQL Server 连接" Style="{StaticResource SectionTitleTextStyle}" />
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource App.AccentSoftBrush}" BorderBrush="{DynamicResource App.BorderStrongBrush}" BorderThickness="1" CornerRadius="3" Padding="9,4">
                                <TextBlock Text="只读结构" Foreground="{DynamicResource App.AccentBrush}" FontSize="10" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="22,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" SharedSizeGroup="ConnectionLabel" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="48" />
                            <RowDefinition Height="48" />
                            <RowDefinition Height="48" />
                            <RowDefinition Height="48" />
                            <RowDefinition Height="48" />
                            <RowDefinition Height="48" />
                            <RowDefinition Height="56" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="连接名称" Style="{StaticResource MutedTextStyle}" />
                        <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" />

                        <TextBlock Grid.Row="1" Text="服务器" Style="{StaticResource MutedTextStyle}" />
                        <TextBox x:Name="ServerBox" Grid.Row="1" Grid.Column="1" />
                        <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" ToolTip="SQL Server 端口，默认 1433" />

                        <TextBlock Grid.Row="2" Text="数据库" Style="{StaticResource MutedTextStyle}" />
                        <TextBox x:Name="DatabaseBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" />

                        <TextBlock Grid.Row="3" Text="登录方式" Style="{StaticResource MutedTextStyle}" />
                        <ComboBox x:Name="AuthModeBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" SelectedIndex="0">
                            <ComboBoxItem Content="Windows 身份验证" />
                            <ComboBoxItem Content="SQL Server 身份验证" />
                        </ComboBox>

                        <TextBlock Grid.Row="4" Text="用户名" Style="{StaticResource MutedTextStyle}" />
                        <TextBox x:Name="UserNameBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" />

                        <TextBlock Grid.Row="5" Text="密码" Style="{StaticResource MutedTextStyle}" />
                        <PasswordBox x:Name="PasswordBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" />

                        <TextBlock Grid.Row="6" Text="安全选项" Style="{StaticResource MutedTextStyle}" />
                        <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="TrustCertificateBox" Content="信任服务器证书" IsChecked="True" />
                            <CheckBox x:Name="ReadOnlyBox" Content="只读模式（固定）" IsChecked="True" IsHitTestVisible="False" Focusable="False" Margin="24,0,0,0" ToolTip="EOS 数据字典只允许读取结构元数据" />
                        </StackPanel>

                        <Border Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Background="{DynamicResource App.WarningBackgroundBrush}" BorderBrush="{DynamicResource App.WarningBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10,0">
                            <TextBlock Text="程序强制只读；生产环境仍建议使用数据库只读账号。" Foreground="{DynamicResource App.TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="MessageText" Foreground="#F4B942" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,16,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="测试连接" Click="TestButton_Click" Width="96" Margin="0,0,8,0" />
                <Button Content="保存" Click="SaveButton_Click" Width="84" Margin="0,0,8,0" />
                <Button Content="连接并关闭" Style="{StaticResource PrimaryButtonStyle}" Click="ConnectButton_Click" Width="112" Margin="0,0,8,0" />
                <Button Content="取消" Click="CancelButton_Click" Width="84" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
