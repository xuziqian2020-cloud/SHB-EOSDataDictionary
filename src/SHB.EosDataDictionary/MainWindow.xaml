<Window x:Class="SHB.EosDataDictionary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SHB.EosDataDictionary.Models"
        xmlns:vm="clr-namespace:SHB.EosDataDictionary.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="胜华波 EOS 数据字典"
        Width="1600"
        Height="980"
        MinWidth="1360"
        MinHeight="760"
        Icon="Assets/EosDataDictionary.ico"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource App.WindowBackgroundBrush}"
        Foreground="{DynamicResource App.TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="ColumnHeaderLabelStyle" TargetType="TextBlock">
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ColumnHeaderStackStyle" TargetType="StackPanel">
            <Setter Property="Height" Value="64" />
            <Setter Property="Margin" Value="0,4,0,2" />
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextMutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource App.ControlHoverBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.78" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C42B1C" /><Setter Property="Foreground" Value="White" /></Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="StatusBadgeTemplate">
            <Grid Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Width" Value="54" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusText}" Value="代码依据">
                                <Setter Property="Width" Value="56" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="{Binding StatusBrush}" CornerRadius="3" Opacity="0.16" />
                <Border BorderBrush="{Binding StatusBrush}" BorderThickness="1" CornerRadius="3" Opacity="0.48" />
                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="10" FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:ModuleNode}" ItemsSource="{Binding Tables}">
            <HierarchicalDataTemplate.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="Margin" Value="0" />
                </Style>
            </HierarchicalDataTemplate.ItemContainerStyle>
            <Grid Height="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Rectangle Width="6" Height="6" Fill="{DynamicResource App.StatusCodeBrush}" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform><RotateTransform Angle="45" /></Rectangle.RenderTransform>
                </Rectangle>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,4,0" />
            </Grid>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type vm:TableDisplayModel}">
            <Grid Height="34" Margin="18,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="›" Foreground="{DynamicResource App.TextMutedBrush}" FontSize="15" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TreeTitle}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding TreeTitle}" />
                    <TextBlock Text="{Binding TreeSubtitle}" Foreground="{DynamicResource App.TextMutedBrush}" FontSize="10" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding TreeSubtitle}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource App.BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="84" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Border x:Name="AppTitleBar" Grid.Row="0" Background="{DynamicResource App.ShellBackgroundBrush}" BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="AppTitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Image Source="{StaticResource EosDictionaryBrandImage}" Width="18" Height="18" Margin="12,0,8,0" />
                    <TextBlock Grid.Column="1" Text="胜华波 EOS 数据字典" Foreground="{DynamicResource App.TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="—" Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeWindowButton_Click" />
                        <Button Content="□" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeWindowButton_Click" />
                        <Button Content="×" Style="{StaticResource TitleBarCloseButtonStyle}" Click="CloseWindowButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

        <Border x:Name="CommandBar" Grid.Row="1" Margin="16,12,16,0" Padding="14,0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ShellBorderStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="305" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" MinWidth="460" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" Background="{DynamicResource App.LogoBackgroundBrush}" BorderBrush="{DynamicResource App.BorderStrongBrush}" BorderThickness="1">
                        <Image Source="{StaticResource EosDictionaryBrandImage}" Width="38" Height="38" />
                    </Border>
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource App.TextPrimaryBrush}" FontSize="18" FontWeight="Bold">
                        <Run Text="胜华波 " /><Run Text="EOS" Foreground="{DynamicResource App.AccentBrush}" /><Run Text=" 数据字典" />
                    </TextBlock>
                </StackPanel>

                <!-- 主界面暂时停用数据库连接，结构连接统一由后续独立结构维护入口管理。 -->
                <StackPanel x:Name="LegacyConnectionPanel" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="当前连接" Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,0,8,0" />
                    <Grid Width="220" Height="36" Margin="0,0,8,0">
                        <ComboBox x:Name="ProfileCombo" Width="220" ItemsSource="{Binding Profiles}" Visibility="Collapsed">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ConnectionProfile}">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Name="ProfilePlaceholder" Text="未连接" Margin="12,0,28,0" VerticalAlignment="Center" Foreground="{DynamicResource App.TextSecondaryBrush}" FontSize="12" IsHitTestVisible="False" Visibility="Collapsed">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=ProfileCombo}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button x:Name="ConnectButton" Width="84" Content="连接" Style="{StaticResource PrimaryButtonStyle}" Click="ConnectButton_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                    <Border Margin="0,0,8,0" Padding="8,4" CornerRadius="3" Background="{DynamicResource App.PanelSecondaryBrush}" BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ConnectionStatusText}" Foreground="{DynamicResource App.TextSecondaryBrush}" FontSize="11" />
                    </Border>
                    <Button x:Name="ManageConnectionsButton" Width="84" Content="连接管理" Click="ManageConnectionsButton_Click" Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 主界面暂时停用源码目录选择，源码扫描统一由结构维护窗口执行。 -->
                    <Button x:Name="SourceButton" Width="84" Content="源码目录" Click="SourceButton_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                    <Button x:Name="AiSettingsButton" Width="84" Content="AI 设置" Click="AiSettingsButton_Click" Margin="0,0,8,0" Visibility="{Binding CanOpenStructureMaintenance, Converter={StaticResource BoolToVisibility}}" />
                    <Button x:Name="UpdateDictionaryButton" Width="84" Content="更新字典" Style="{StaticResource PrimaryButtonStyle}" Click="UpdateDictionaryButton_Click" Margin="0,0,8,0" />
                    <Button x:Name="EditDictionaryButton" Width="84" Content="编辑字典" Click="EditDictionaryButton_Click" Margin="0,0,8,0" />
                    <Button x:Name="SyncSettingsButton" Width="84" Content="同步设置" Click="SyncSettingsButton_Click" Margin="0,0,8,0" />
                    <Button x:Name="StructureMaintenanceButton" Width="84" Content="结构维护" Click="StructureMaintenanceButton_Click" Margin="0,0,8,0" Visibility="{Binding CanOpenStructureMaintenance, Converter={StaticResource BoolToVisibility}}" />
                    <Button x:Name="ThemeButton" Width="42" Style="{StaticResource IconButtonStyle}" Click="ThemeButton_Click" ToolTip="切换浅色/深色主题">
                        <Grid Width="18" Height="18">
                            <Ellipse Width="7" Height="7" Stroke="{DynamicResource App.TextPrimaryBrush}" StrokeThickness="1.4" />
                            <Path Stroke="{DynamicResource App.TextPrimaryBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 9,0 L 9,3 M 9,15 L 9,18 M 0,9 L 3,9 M 15,9 L 18,9 M 2.6,2.6 L 4.7,4.7 M 13.3,13.3 L 15.4,15.4 M 15.4,2.6 L 13.3,4.7 M 4.7,13.3 L 2.6,15.4" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="0.95*" MinWidth="630" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1.05*" MinWidth="680" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                        <TextBlock Text="资源目录" Style="{StaticResource SectionTitleTextStyle}" />
                    </Border>
                    <TreeView x:Name="ResourceTree" Grid.Row="1" Margin="8,8,8,10" ItemsSource="{Binding ModuleNodes}" SelectedItemChanged="ResourceTree_SelectedItemChanged"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="Margin" Value="0,4,0,0" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" />

            <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="54" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                        <Grid>
                            <TextBlock Text="数据表" Style="{StaticResource SectionTitleTextStyle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <CheckBox x:Name="ShowEosEntityObjectsOnlyCheckBox" Content="仅显示 EOS 有对应实体" IsChecked="{Binding ShowEosEntityObjectsOnly, Mode=TwoWay}" FontSize="12" Margin="0,0,14,0" />
                                <CheckBox x:Name="ShowAllObjectsCheckBox" Content="显示全部对象" IsChecked="{Binding ShowAllObjects, Mode=TwoWay}" FontSize="12" Margin="0,0,14,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 长表名搜索需要完整显示，搜索入口固定在数据表区域的独立行中。 -->
                    <Grid Grid.Row="1" Margin="12,7">
                        <TextBox x:Name="TableSearchBox" Padding="36,0,12,0" TextChanged="TableSearchBox_TextChanged" ToolTip="在当前对象范围内搜索中文表名、英文表名、模块或实体" />
                        <Path Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" Stretch="Uniform" Stroke="{DynamicResource App.TextMutedBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 10.5,4 A 6.5,6.5 0 1 1 10.5,17 A 6.5,6.5 0 1 1 10.5,4 M 15.5,15.5 L 20.5,20.5" Panel.ZIndex="2" IsHitTestVisible="False" />
                        <TextBlock Margin="36,0,12,0" Text="在当前范围内搜索表名、模块或实体" Foreground="{DynamicResource App.TextMutedBrush}" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" Panel.ZIndex="2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TableSearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <DataGrid x:Name="TablesGrid" Grid.Row="2" ItemsSource="{Binding TableRows}" SelectedItem="{Binding SelectedTable, Mode=TwoWay}" SelectionMode="Single" SelectionUnit="FullRow" MouseDoubleClick="TablesGrid_MouseDoubleClick" PreviewMouseDoubleClick="DataGrid_PreviewMouseDoubleClick" PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown" PreviewKeyDown="DataGrid_PreviewKeyDown" HorizontalScrollBarVisibility="Auto" CanUserResizeColumns="True">
                        <DataGrid.ContextMenu><ContextMenu><MenuItem Header="复制单元格" Click="CopyCellMenuItem_Click" /></ContextMenu></DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="78" CellTemplate="{StaticResource StatusBadgeTemplate}">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Style="{StaticResource ColumnHeaderStackStyle}"><TextBlock Text="状态" Style="{StaticResource ColumnHeaderLabelStyle}" /><TextBox x:Name="TableStatusFilterBox" Tag="StatusText" Style="{StaticResource ColumnFilterTextBoxStyle}" TextChanged="TableColumnFilter_TextChanged" /></StackPanel>
                                </DataGridTemplateColumn.Header>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding ChineseName}" Width="220" MinWidth="100" ElementStyle="{StaticResource CenteredDataGridTextStyle}">
                                <DataGridTextColumn.Header><StackPanel Style="{StaticResource ColumnHeaderStackStyle}"><TextBlock Text="中文表名" Style="{StaticResource ColumnHeaderLabelStyle}" /><TextBox x:Name="TableChineseNameFilterBox" Tag="ChineseName" Style="{StaticResource ColumnFilterTextBoxStyle}" TextChanged="TableColumnFilter_TextChanged" /></StackPanel></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding ObjectName}" Width="260" MinWidth="120" ElementStyle="{StaticResource CenteredDataGridTextStyle}">
                                <DataGridTextColumn.Header><StackPanel Style="{StaticResource ColumnHeaderStackStyle}"><TextBlock Text="英文表名" Style="{StaticResource ColumnHeaderLabelStyle}" /><TextBox x:Name="TableObjectNameFilterBox" Tag="ObjectName" Style="{StaticResource ColumnFilterTextBoxStyle}" TextChanged="TableColumnFilter_TextChanged" /></StackPanel></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding ObjectTypeText}" Width="66" ElementStyle="{StaticResource CenteredDataGridTextStyle}">
                                <DataGridTextColumn.Header><StackPanel Style="{StaticResource ColumnHeaderStackStyle}"><TextBlock Text="对象" Style="{StaticResource ColumnHeaderLabelStyle}" /><TextBox x:Name="TableObjectTypeFilterBox" Tag="ObjectTypeText" Style="{StaticResource ColumnFilterTextBoxStyle}" TextChanged="TableColumnFilter_TextChanged" /></StackPanel></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding ModuleName}" Width="160" MinWidth="96" ElementStyle="{StaticResource CenteredDataGridTextStyle}">
                                <DataGridTextColumn.Header><StackPanel Style="{StaticResource ColumnHeaderStackStyle}"><TextBlock Text="模块" Style="{StaticResource ColumnHeaderLabelStyle}" /><TextBox x:Name="TableModuleFilterBox" Tag="ModuleName" Style="{StaticResource ColumnFilterTextBoxStyle}" TextChanged="TableColumnFilter_TextChanged" /></StackPanel></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding EntityName}" Width="220" MinWidth="135" ElementStyle="{StaticResource CenteredDataGridTextStyle}">
                                <DataGridTextColumn.Header><StackPanel Style="{StaticResource ColumnHeaderStackStyle}"><TextBlock Text="实体" Style="{StaticResource ColumnHeaderLabelStyle}" /><TextBox x:Name="TableEntityFilterBox" Tag="EntityName" Style="{StaticResource ColumnFilterTextBoxStyle}" TextChanged="TableColumnFilter_TextChanged" /></StackPanel></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" />

            <Border Grid.Column="4" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="62" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding CurrentObjectText}" Foreground="{DynamicResource App.TextPrimaryBrush}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding CurrentObjectSubText}" Foreground="{DynamicResource App.TextMutedBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TabControl Grid.Row="1">
                        <TabItem Header="字段字典">
                            <DataGrid x:Name="FieldsGrid" ItemsSource="{Binding FieldRows}" SelectedItem="{Binding SelectedField, Mode=TwoWay}" SelectionMode="Single" SelectionUnit="FullRow" MouseDoubleClick="FieldsGrid_MouseDoubleClick" PreviewMouseDoubleClick="DataGrid_PreviewMouseDoubleClick" PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown" PreviewKeyDown="DataGrid_PreviewKeyDown" HorizontalScrollBarVisibility="Auto" CanUserResizeColumns="True">
                                <DataGrid.ContextMenu><ContextMenu><MenuItem Header="复制单元格" Click="CopyCellMenuItem_Click" /></ContextMenu></DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="78" CellTemplate="{StaticResource StatusBadgeTemplate}">
                                        <DataGridTemplateColumn.Header><StackPanel Style="{StaticResource ColumnHeaderStackStyle}"><TextBlock Text="状态" Style="{StaticResource ColumnHeaderLabelStyle}" /><TextBox Tag="StatusText" Style="{StaticResource ColumnFilterTextBoxStyle}" TextChanged="FieldColumnFilter_TextChanged" /></StackPanel></DataGridTemplateColumn.Header>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Binding="{Binding FieldName}" Width="110" ElementStyle="{StaticResource CenteredDataGridTextStyle}">
                                        <DataGridTextColumn.Header><StackPanel Style="{StaticResource ColumnHeaderStackStyle}"><TextBlock Text="字段" Style="{StaticResource ColumnHeaderLabelStyle}" /><TextBox Tag="FieldName" Style="{StaticResource ColumnFilterTextBoxStyle}" TextChanged="FieldColumnFilter_TextChanged" /></StackPanel></DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding ChineseName}" Width="200" ElementStyle="{StaticResource CenteredDataGridTextStyle}">
                                        <DataGridTextColumn.Header><StackPanel Style="{StaticResource ColumnHeaderStackStyle}"><TextBlock Text="字段名称" Style="{StaticResource ColumnHeaderLabelStyle}" /><TextBox Tag="ChineseName" Style="{StaticResource ColumnFilterTextBoxStyle}" TextChanged="FieldColumnFilter_TextChanged" /></StackPanel></DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding OwnerTableName}" Width="140" ElementStyle="{StaticResource CenteredDataGridTextStyle}">
                                        <DataGridTextColumn.Header><StackPanel Style="{StaticResource ColumnHeaderStackStyle}"><TextBlock Text="表名" Style="{StaticResource ColumnHeaderLabelStyle}" /><TextBox Tag="OwnerTableName" Style="{StaticResource ColumnFilterTextBoxStyle}" TextChanged="FieldColumnFilter_TextChanged" /></StackPanel></DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding DataType}" Width="100" ElementStyle="{StaticResource CenteredDataGridTextStyle}">
                                        <DataGridTextColumn.Header><StackPanel Style="{StaticResource ColumnHeaderStackStyle}"><TextBlock Text="类型" Style="{StaticResource ColumnHeaderLabelStyle}" /><TextBox Tag="DataType" Style="{StaticResource ColumnFilterTextBoxStyle}" TextChanged="FieldColumnFilter_TextChanged" /></StackPanel></DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding EnumText}" Width="240" ElementStyle="{StaticResource CenteredDataGridTextStyle}">
                                        <DataGridTextColumn.Header><StackPanel Style="{StaticResource ColumnHeaderStackStyle}"><TextBlock Text="枚举类型 / 值" Style="{StaticResource ColumnHeaderLabelStyle}" /><TextBox Tag="EnumText" Style="{StaticResource ColumnFilterTextBoxStyle}" TextChanged="FieldColumnFilter_TextChanged" /></StackPanel></DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding LengthText}" Width="70" ElementStyle="{StaticResource CenteredDataGridTextStyle}">
                                        <DataGridTextColumn.Header><StackPanel Style="{StaticResource ColumnHeaderStackStyle}"><TextBlock Text="长度" Style="{StaticResource ColumnHeaderLabelStyle}" /><TextBox Tag="LengthText" Style="{StaticResource ColumnFilterTextBoxStyle}" TextChanged="FieldColumnFilter_TextChanged" /></StackPanel></DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding RequiredText}" Width="65" ElementStyle="{StaticResource CenteredDataGridTextStyle}">
                                        <DataGridTextColumn.Header><StackPanel Style="{StaticResource ColumnHeaderStackStyle}"><TextBlock Text="必填" Style="{StaticResource ColumnHeaderLabelStyle}" /><TextBox Tag="RequiredText" Style="{StaticResource ColumnFilterTextBoxStyle}" TextChanged="FieldColumnFilter_TextChanged" /></StackPanel></DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding KeyText}" Width="80" ElementStyle="{StaticResource CenteredDataGridTextStyle}">
                                        <DataGridTextColumn.Header><StackPanel Style="{StaticResource ColumnHeaderStackStyle}"><TextBlock Text="键" Style="{StaticResource ColumnHeaderLabelStyle}" /><TextBox Tag="KeyText" Style="{StaticResource ColumnFilterTextBoxStyle}" TextChanged="FieldColumnFilter_TextChanged" /></StackPanel></DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding RelationText}" Width="260" ElementStyle="{StaticResource CenteredDataGridTextStyle}">
                                        <DataGridTextColumn.Header><StackPanel Style="{StaticResource ColumnHeaderStackStyle}"><TextBlock Text="关联关系" Style="{StaticResource ColumnHeaderLabelStyle}" /><TextBox Tag="RelationText" Style="{StaticResource ColumnFilterTextBoxStyle}" TextChanged="FieldColumnFilter_TextChanged" /></StackPanel></DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="关联关系">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Border Background="{DynamicResource App.PanelSecondaryBrush}" BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="0,0,0,1" Padding="12,0">
                                    <TextBlock Text="{Binding RelationDetailText}" Foreground="{DynamicResource App.TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelationDetailText}" />
                                </Border>
                                <DataGrid x:Name="RelationsGrid" Grid.Row="1" ItemsSource="{Binding RelationRows}" SelectedItem="{Binding SelectedRelation, Mode=TwoWay}" MouseDoubleClick="RelationsGrid_MouseDoubleClick" PreviewMouseDoubleClick="DataGrid_PreviewMouseDoubleClick" PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown" PreviewKeyDown="DataGrid_PreviewKeyDown" HorizontalScrollBarVisibility="Auto" CanUserResizeColumns="True">
                                    <DataGrid.ContextMenu><ContextMenu><MenuItem Header="复制单元格" Click="CopyCellMenuItem_Click" /></ContextMenu></DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="90" CellTemplate="{StaticResource StatusBadgeTemplate}">
                                            <DataGridTemplateColumn.Header><StackPanel Style="{StaticResource ColumnHeaderStackStyle}"><TextBlock Text="状态" Style="{StaticResource ColumnHeaderLabelStyle}" /><TextBox Tag="StatusText" Style="{StaticResource ColumnFilterTextBoxStyle}" TextChanged="RelationColumnFilter_TextChanged" /></StackPanel></DataGridTemplateColumn.Header>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding ParentTableName}" Width="163" ElementStyle="{StaticResource CenteredDataGridTextStyle}">
                                            <DataGridTextColumn.Header><StackPanel Style="{StaticResource ColumnHeaderStackStyle}"><TextBlock Text="父表" Style="{StaticResource ColumnHeaderLabelStyle}" /><TextBox Tag="ParentTableName" Style="{StaticResource ColumnFilterTextBoxStyle}" TextChanged="RelationColumnFilter_TextChanged" /></StackPanel></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding ParentFieldName}" Width="90" ElementStyle="{StaticResource CenteredDataGridTextStyle}">
                                            <DataGridTextColumn.Header><StackPanel Style="{StaticResource ColumnHeaderStackStyle}"><TextBlock Text="父字段" Style="{StaticResource ColumnHeaderLabelStyle}" /><TextBox Tag="ParentFieldName" Style="{StaticResource ColumnFilterTextBoxStyle}" TextChanged="RelationColumnFilter_TextChanged" /></StackPanel></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding ChildTableName}" Width="163" ElementStyle="{StaticResource CenteredDataGridTextStyle}">
                                            <DataGridTextColumn.Header><StackPanel Style="{StaticResource ColumnHeaderStackStyle}"><TextBlock Text="子表" Style="{StaticResource ColumnHeaderLabelStyle}" /><TextBox Tag="ChildTableName" Style="{StaticResource ColumnFilterTextBoxStyle}" TextChanged="RelationColumnFilter_TextChanged" /></StackPanel></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding ChildFieldName}" Width="90" ElementStyle="{StaticResource CenteredDataGridTextStyle}">
                                            <DataGridTextColumn.Header><StackPanel Style="{StaticResource ColumnHeaderStackStyle}"><TextBlock Text="子字段" Style="{StaticResource ColumnHeaderLabelStyle}" /><TextBox Tag="ChildFieldName" Style="{StaticResource ColumnFilterTextBoxStyle}" TextChanged="RelationColumnFilter_TextChanged" /></StackPanel></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding RelationType}" Width="164" ElementStyle="{StaticResource CenteredDataGridTextStyle}">
                                            <DataGridTextColumn.Header><StackPanel Style="{StaticResource ColumnHeaderStackStyle}"><TextBlock Text="关系类型" Style="{StaticResource ColumnHeaderLabelStyle}" /><TextBox Tag="RelationType" Style="{StaticResource ColumnFilterTextBoxStyle}" TextChanged="RelationColumnFilter_TextChanged" /></StackPanel></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="来源证据">
                            <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <StackPanel Margin="18">
                                    <TextBlock Text="当前对象证据" Foreground="{DynamicResource App.TextPrimaryBrush}" FontSize="15" FontWeight="Bold" />
                                    <Border Margin="0,12,0,0" Background="{DynamicResource App.PanelSecondaryBrush}" BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="1" Padding="14">
                                        <TextBlock Text="{Binding CurrentEvidenceText}" Foreground="{DynamicResource App.TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource App.TextMutedBrush}" FontSize="11" Text="无法由数据库或代码证据确认的内容，统一显示为“推测”。" />
                                </StackPanel>
                            </ScrollViewer>
                            <DataGrid x:Name="EvidenceGrid" ItemsSource="{Binding EvidenceRows}" PreviewMouseDoubleClick="DataGrid_PreviewMouseDoubleClick" PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown" PreviewKeyDown="DataGrid_PreviewKeyDown" HorizontalScrollBarVisibility="Auto" CanUserResizeColumns="True">
                                <DataGrid.ContextMenu><ContextMenu><MenuItem Header="复制单元格" Click="CopyCellMenuItem_Click" /></ContextMenu></DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding SourceType}" Header="来源类型" Width="100" ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                    <DataGridTextColumn Binding="{Binding SourcePath}" Header="来源路径" Width="220" ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                    <DataGridTextColumn Binding="{Binding SourceLine}" Header="行号" Width="65" ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                    <DataGridTextColumn Binding="{Binding RuleName}" Header="规则" Width="135" ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                    <DataGridTextColumn Binding="{Binding Explanation}" Header="说明" Width="260" ElementStyle="{StaticResource CenteredDataGridTextStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource ShellBorderStyle}" Margin="16,0,16,10" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel x:Name="GitHubFooterStatusPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="GitHub 阶段：" Foreground="{DynamicResource App.TextMutedBrush}" FontSize="12" />
                    <TextBlock x:Name="GitHubStatusText" Text="{Binding SyncStatusText}" Foreground="{DynamicResource App.TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="　最近获取：" Foreground="{DynamicResource App.TextMutedBrush}" FontSize="12" />
                    <TextBlock x:Name="GitHubLastFetchText" Text="{Binding LastSyncText}" Foreground="{DynamicResource App.TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="　待上传：" Foreground="{DynamicResource App.TextMutedBrush}" FontSize="12" />
                    <TextBlock x:Name="GitHubPendingUploadText" Text="{Binding PendingUploadCount}" Foreground="{DynamicResource App.TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="　待生效：" Foreground="{DynamicResource App.TextMutedBrush}" FontSize="12" />
                    <TextBlock x:Name="GitHubPendingApplyText" Text="{Binding PendingApplyCount}" Foreground="{DynamicResource App.TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
                    <Border x:Name="GitHubOfflineBadge" Margin="8,0,0,0" Padding="6,2" CornerRadius="3" Background="{DynamicResource App.WarningBackgroundBrush}" BorderBrush="{DynamicResource App.WarningBorderBrush}" BorderThickness="1" Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="离线" Foreground="{DynamicResource App.WarningTextBrush}" FontSize="11" FontWeight="Bold" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TableCountText, StringFormat=结构已加载 · {0}}" Foreground="{DynamicResource App.TextMutedBrush}" FontSize="12" />
                    <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource App.AccentBrush}" FontSize="12" Margin="18,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="BusyOverlay" Grid.Row="1" Grid.RowSpan="2" Margin="16,12,16,12" Background="#C007111E" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Panel.ZIndex="20">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="260" Height="5" IsIndeterminate="True" Foreground="{DynamicResource App.AccentBrush}" />
                <TextBlock Text="正在恢复或同步 GitHub 共享字典…" Foreground="White" Margin="0,12,0,0" HorizontalAlignment="Center" />
                <Button x:Name="CancelLoadButton" Width="96" Height="36" Margin="0,16,0,0" Content="取消加载" Click="CancelLoadButton_Click" />
            </StackPanel>
        </Border>
        </Grid>
    </Border>
</Window>
